{
  "name": "vibecolors",
  "displayName": "VibeColors",
  "description": "Modern, colorful VS Code theme designed for programmers with comprehensive dark and light variants",
  "version": "1.1.3",
  "publisher": "AlexLi",
  "icon": "vc.png",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Themes"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "keywords": [
    "theme",
    "dark",
    "light",
    "modern",
    "colorful",
    "programming",
    "syntax-highlighting",
    "vibe",
    "developer"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yili6ms/VibeColors.git"
  },
  "contributes": {
    "commands": [
      {
        "command": "vibeColors.refresh",
        "title": "Refresh Dynamic Theme",
        "category": "VibeColors"
      },
      {
        "command": "vibeColors.refreshDark",
        "title": "Generate New Dark Theme",
        "category": "VibeColors"
      },
      {
        "command": "vibeColors.refreshLight",
        "title": "Generate New Light Theme",
        "category": "VibeColors"
      },
      {
        "command": "vibeColors.switchVariant",
        "title": "Switch Dark/Light Variant",
        "category": "VibeColors"
      },
      {
        "command": "vibeColors.savePalette",
        "title": "Save Current Palette",
        "category": "VibeColors"
      },
      {
        "command": "vibeColors.loadPalette",
        "title": "Load Saved Palette",
        "category": "VibeColors"
      },
      {
        "command": "vibeColors.regenerateDynamicConfig",
        "title": "Regenerate Dynamic Configuration",
        "category": "VibeColors"
      },
      {
        "command": "vibeColors.shuffleNext",
        "title": "Shuffle: Next Theme",
        "category": "VibeColors"
      },
      {
        "command": "vibeColors.shufflePick",
        "title": "Shuffle: Pick Theme...",
        "category": "VibeColors"
      },
      {
        "command": "vibeColors.shuffleReseed",
        "title": "Shuffle: Reshuffle With New Random Seed",
        "category": "VibeColors"
      }
    ],
    "configuration": {
      "title": "VibeColors",
      "properties": {
        "vibeColors.persistSeed": {
          "type": "boolean",
          "default": false,
          "description": "Persist the last used seed between sessions"
        },
        "vibeColors.lastSeed": {
          "type": "number",
          "default": 0,
          "scope": "machine",
          "description": "Last used seed for palette generation"
        },
        "vibeColors.savedPalettes": {
          "type": "array",
          "default": [],
          "description": "Saved color palettes"
        },
        "vibeColors.autoRefreshInterval": {
          "type": "number",
          "default": 0,
          "description": "Auto-refresh interval in minutes for Dynamic themes (0 = disabled)"
        },
        "vibeColors.autoThemePeriodMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "description": "How often the VibeColors Auto themes regenerate their colors, in minutes."
        },
        "vibeColors.shuffle.intervalMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "description": "How often the VibeColors Shuffle themes switch to the next theme in their playlist, in minutes (0 = switch only on demand)."
        },
        "vibeColors.shuffle.sessionSeed": {
          "type": [
            "number",
            "string"
          ],
          "default": 0,
          "markdownDescription": "Seed for the Shuffle playlist order and its random palettes. `0` picks a new random seed when VS Code starts (windows opened later join the running session). Set it to a number or hex string (e.g. `\"3f9a12c4\"`) to replay the same sequence; changing it restarts that sequence."
        },
        "vibeColors.shuffle.sources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "builtinThemes",
              "themeFiles",
              "builtinSeeds",
              "seeds",
              "savedPalettes",
              "random"
            ],
            "enumDescriptions": [
              "The static VibeColors themes (Neon, Ocean, Pastel, ...).",
              "Theme files listed in vibeColors.shuffle.themeFiles.",
              "Curated, pre-generated palette seeds bundled with VibeColors.",
              "Seeds listed in vibeColors.shuffle.seeds.",
              "Palettes saved with \"VibeColors: Save Current Palette\".",
              "Palettes generated from the session seed when VS Code starts (see vibeColors.shuffle.randomCount)."
            ]
          },
          "default": [
            "builtinThemes",
            "themeFiles",
            "builtinSeeds",
            "seeds",
            "savedPalettes",
            "random"
          ],
          "description": "Where the VibeColors Shuffle themes get their playlist from. Only entries matching the Shuffle theme's dark/light variant are used."
        },
        "vibeColors.shuffle.randomCount": {
          "type": "integer",
          "default": 4,
          "minimum": 0,
          "maximum": 50,
          "description": "How many random palettes to pre-generate from the session seed for each Shuffle variant."
        },
        "vibeColors.shuffle.seeds": {
          "type": "array",
          "items": {
            "type": [
              "number",
              "string"
            ]
          },
          "default": [],
          "markdownDescription": "Extra palette seeds for the Shuffle playlist: numbers or hex strings as shown by VibeColors, optionally with a style suffix, e.g. `\"3f9a12c4\"` or `\"3f9a12c4:vivid\"` (`standard`, `vivid`, `muted`)."
        },
        "vibeColors.shuffle.themeFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra VS Code color theme JSON files (or folders of them) for the Shuffle playlist. Supports `~`, `${userHome}` and `${workspaceFolder}`; relative paths resolve against the workspace folder. Dark/light is detected from the theme's `type` or editor background."
        }
      }
    },
    "themes": [
      {
        "label": "VibeColors Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/VibeColors-dark-theme.json"
      },
      {
        "label": "VibeColors High Contrast Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/VibeColors-high-contrast-dark-theme.json"
      },
      {
        "label": "VibeColors Neon Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/VibeColors-neon-dark-theme.json"
      },
      {
        "label": "VibeColors Soft Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/VibeColors-soft-dark-theme.json"
      },
      {
        "label": "VibeColors Retro Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/VibeColors-retro-dark-theme.json"
      },
      {
        "label": "VibeColors Ocean Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/VibeColors-ocean-dark-theme.json"
      },
      {
        "label": "VibeColors Light",
        "uiTheme": "vs",
        "path": "./themes/VibeColors-light-theme.json"
      },
      {
        "label": "VibeColors Minimal Light",
        "uiTheme": "vs",
        "path": "./themes/VibeColors-minimal-light-theme.json"
      },
      {
        "label": "VibeColors Pastel Light",
        "uiTheme": "vs",
        "path": "./themes/VibeColors-pastel-light-theme.json"
      },
      {
        "label": "VibeColors Corporate Light",
        "uiTheme": "vs",
        "path": "./themes/VibeColors-corporate-light-theme.json"
      },
      {
        "label": "VibeColors Sunset Light",
        "uiTheme": "vs",
        "path": "./themes/VibeColors-sunset-light-theme.json"
      },
      {
        "label": "VibeColors Dynamic Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/VibeColors-dynamic-dark-theme.json",
        "_watch": true
      },
      {
        "label": "VibeColors Dynamic Light",
        "uiTheme": "vs",
        "path": "./themes/VibeColors-dynamic-light-theme.json",
        "_watch": true
      },
      {
        "label": "VibeColors Dynamic Vivid Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/VibeColors-dynamic-vivid-dark-theme.json",
        "_watch": true
      },
      {
        "label": "VibeColors Dynamic Vivid Light",
        "uiTheme": "vs",
        "path": "./themes/VibeColors-dynamic-vivid-light-theme.json",
        "_watch": true
      },
      {
        "label": "VibeColors Dynamic Muted Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/VibeColors-dynamic-muted-dark-theme.json",
        "_watch": true
      },
      {
        "label": "VibeColors Dynamic Muted Light",
        "uiTheme": "vs",
        "path": "./themes/VibeColors-dynamic-muted-light-theme.json",
        "_watch": true
      },
      {
        "label": "VibeColors Auto Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/VibeColors-auto-dark-theme.json",
        "_watch": true
      },
      {
        "label": "VibeColors Auto Light",
        "uiTheme": "vs",
        "path": "./themes/VibeColors-auto-light-theme.json",
        "_watch": true
      },
      {
        "label": "VibeColors Shuffle Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/VibeColors-shuffle-dark-theme.json",
        "_watch": true
      },
      {
        "label": "VibeColors Shuffle Light",
        "uiTheme": "vs",
        "path": "./themes/VibeColors-shuffle-light-theme.json",
        "_watch": true
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run version:bump && npm run compile",
    "version:bump": "node ./scripts/bump-version.js",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "vitest run",
    "prepare": "node ./scripts/setup-hooks.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.104.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^4.9.4",
    "vitest": "^0.34.6"
  }
}
