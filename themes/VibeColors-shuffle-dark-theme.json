	"tokenColors": [
		{
			"name": "Comment",
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#d0bfb9cc"
			}
		},
		{
			"name": "String",
			"scope": [
				"string"
			],
			"settings": {
				"foreground": "#89e88f"
			}
		},
		{
			"name": "Number",
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character"
			],
			"settings": {
				"foreground": "#eed880"
			}
		},
		{
			"name": "Keyword",
			"scope": [
				"keyword",
				"storage.type",
				"storage.modifier"
			],
			"settings": {
				"foreground": "#86e4b8"
			}
		},
		{
			"name": "Function",
			"scope": [
				"entity.name.function",
				"meta.function-call",
				"variable.function",
				"support.function"
			],
			"settings": {
				"foreground": "#b6b8f5"
			}
		},
		{
			"name": "Class",
			"scope": [
				"entity.name.class",
				"entity.name.type",
				"support.type",
				"support.class"
			],
			"settings": {
				"foreground": "#e0b3ea"
			}
		},
		{
			"name": "Variable",
			"scope": [
				"variable"
			],
			"settings": {
				"foreground": "#f0e8e5"
			}
		},
		{
			"name": "Property",
			"scope": [
				"variable.other.property",
				"support.type.property-name"
			],
			"settings": {
				"foreground": "#6cc9e5"
			}
		},
		{
			"name": "Tag",
			"scope": [
				"entity.name.tag"
			],
			"settings": {
				"foreground": "#eda190"
			}
		},
		{
			"name": "Attribute",
			"scope": [
				"entity.other.attribute-name"
			],
			"settings": {
				"foreground": "#b4e1a3"
			}
		},
		{
			"name": "Operator",
			"scope": [
				"keyword.control",
				"punctuation",
				"keyword.operator"
			],
			"settings": {
				"foreground": "#d0bfb9"
			}
		},
		{
			"name": "Import/Export",
			"scope": [
				"keyword.control.import",
				"keyword.control.export",
				"keyword.control.from"
			],
			"settings": {
				"foreground": "#86e4b8"
			}
		},
		{
			"name": "Type",
			"scope": [
				"entity.name.type",
				"support.type.primitive"
			],
			"settings": {
				"foreground": "#b7eced"
			}
		},
		{
			"name": "Invalid",
			"scope": [
				"invalid",
				"invalid.illegal"
			],
			"settings": {
				"background": "#eda190",
				"foreground": "#1f1512"
			}
		},
		{
			"name": "Deprecated",
			"scope": [
				"invalid.deprecated"
			],
			"settings": {
				"foreground": "#dda2a4",
				"fontStyle": "italic strikethrough"
			}
		},
		{
			"name": "Constants",
			"scope": [
				"constant.other",
				"support.constant"
			],
			"settings": {
				"foreground": "#dda2a4"
			}
		},
		{
			"name": "Documentation",
			"scope": [
				"comment.block.documentation",
				"string.quoted.docstring"
			],
			"settings": {
				"foreground": "#eadfa4",
				"fontStyle": "italic"
			}
		},
		{
			"name": "String Escape Characters",
			"scope": [
				"constant.character.escape"
			],
			"settings": {
				"foreground": "#eadfa4"
			}
		}
	]
}