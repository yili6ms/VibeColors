	"tokenColors": [
		{
			"name": "Comment",
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"fontStyle": "italic",
				"foreground": "#56403fcc"
			}
		},
		{
			"name": "String",
			"scope": [
				"string"
			],
			"settings": {
				"foreground": "#29a96f"
			}
		},
		{
			"name": "Number",
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character"
			],
			"settings": {
				"foreground": "#e8a83f"
			}
		},
		{
			"name": "Keyword",
			"scope": [
				"keyword",
				"storage.type",
				"storage.modifier"
			],
			"settings": {
				"foreground": "#21964d"
			}
		},
		{
			"name": "Function",
			"scope": [
				"entity.name.function",
				"meta.function-call",
				"variable.function",
				"support.function"
			],
			"settings": {
				"foreground": "#6094ec"
			}
		},
		{
			"name": "Class",
			"scope": [
				"entity.name.class",
				"entity.name.type",
				"support.type",
				"support.class"
			],
			"settings": {
				"foreground": "#8b32b8"
			}
		},
		{
			"name": "Variable",
			"scope": [
				"variable"
			],
			"settings": {
				"foreground": "#2c1d1c"
			}
		},
		{
			"name": "Property",
			"scope": [
				"variable.other.property",
				"support.type.property-name"
			],
			"settings": {
				"foreground": "#187d86"
			}
		},
		{
			"name": "Tag",
			"scope": [
				"entity.name.tag"
			],
			"settings": {
				"foreground": "#da4114"
			}
		},
		{
			"name": "Attribute",
			"scope": [
				"entity.other.attribute-name"
			],
			"settings": {
				"foreground": "#5f9d33"
			}
		},
		{
			"name": "Operator",
			"scope": [
				"keyword.control",
				"punctuation",
				"keyword.operator"
			],
			"settings": {
				"foreground": "#56403f"
			}
		},
		{
			"name": "Import/Export",
			"scope": [
				"keyword.control.import",
				"keyword.control.export",
				"keyword.control.from"
			],
			"settings": {
				"foreground": "#21964d"
			}
		},
		{
			"name": "Type",
			"scope": [
				"entity.name.type",
				"support.type.primitive"
			],
			"settings": {
				"foreground": "#2f71ec"
			}
		},
		{
			"name": "Invalid",
			"scope": [
				"invalid",
				"invalid.illegal"
			],
			"settings": {
				"background": "#da4114",
				"foreground": "#f9f8f8"
			}
		},
		{
			"name": "Deprecated",
			"scope": [
				"invalid.deprecated"
			],
			"settings": {
				"foreground": "#d35b60",
				"fontStyle": "italic strikethrough"
			}
		},
		{
			"name": "Constants",
			"scope": [
				"constant.other",
				"support.constant"
			],
			"settings": {
				"foreground": "#d35b60"
			}
		},
		{
			"name": "Documentation",
			"scope": [
				"comment.block.documentation",
				"string.quoted.docstring"
			],
			"settings": {
				"foreground": "#d7b642",
				"fontStyle": "italic"
			}
		},
		{
			"name": "String Escape Characters",
			"scope": [
				"constant.character.escape"
			],
			"settings": {
				"foreground": "#d7b642"
			}
		}
	]
}